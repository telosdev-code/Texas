{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../src/*"
      ],
      "@react-native-async-storage/async-storage": [
        "./node_modules/@react-native-async-storage/async-storage"
      ]
    },
    "moduleSuffixes": [
      ".native",
      ""
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
